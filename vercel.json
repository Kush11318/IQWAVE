{
  "version": 2,
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/fixtures/(.*)",
      "destination": "/fixtures/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/experimental/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/Frontend-Experimental/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/experimental",
      "destination": "/index.html"
    },
    {
      "source": "/experimental/",
      "destination": "/index.html"
    },
    {
      "source": "/exp",
      "destination": "/index.html"
    },
    {
      "source": "/radar",
      "destination": "/index.html"
    },
    {
      "source": "/radar-labview",
      "destination": "/index.html"
    },
    {
      "source": "/Frontend-Experimental",
      "destination": "/index.html"
    }
  ]
}
